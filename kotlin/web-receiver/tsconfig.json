{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "isolatedModules": true
  },
  "include": [
    "preview.ts",
    "protocol/**/*.ts",
    "shared/**/*.ts",
    "receiver/**/*.ts",
    "probe/**/*.ts"
  ],
  "exclude": [
    "receiver/worker.ts"
  ]
}
